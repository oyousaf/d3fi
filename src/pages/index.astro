---
import Layout from "../layouts/Layout.astro";
import CryptoGrid from "../components/CryptoGrid.astro";
import TrendingGrid from "../components/TrendingGrid.astro";
import { fetchCryptoData, fetchTrendingCoins } from "../utils/fetchCrypto";

const cryptos = await fetchCryptoData();
const trending = await fetchTrendingCoins();
---

<Layout title="Crypto Tracker — Live cryptocurrency prices">
  <section aria-labelledby="top-cryptos-heading">
    <h1 id="top-cryptos-heading" class="mb-6 text-3xl font-extrabold tracking-tight text-ink">
      Top 10 Cryptocurrencies
    </h1>
    <CryptoGrid cryptos={cryptos} />
  </section>

  <section aria-labelledby="trending-heading" class="mt-16">
    <h2 id="trending-heading" class="mb-6 text-2xl font-bold tracking-tight text-ink">
      Trending Right Now
    </h2>
    <TrendingGrid coins={trending} />
  </section>
</Layout>
